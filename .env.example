# 서버에서 이 파일을 .env로 복사해 값을 채웁니다. (.env는 절대 커밋하지 않음)
#   cp .env.example .env

# Caddy가 HTTPS 인증서를 발급받을 도메인 (예: handeulpan.duckdns.org)
DOMAIN=your-domain.example.org

POSTGRES_DB=handeulpan
POSTGRES_USER=handeulpan
POSTGRES_PASSWORD=change-me

# 데모 되감기 API(X-Demo-Key)에 쓰는 키. 비워 두면 데모 API가 항상 거부됩니다.
HANDEULPAN_DEMO_KEY=change-me

# 선택: JVM 옵션 (메모리가 작은 서버용 기본값)
# JAVA_OPTS=-Xms128m -Xmx512m
